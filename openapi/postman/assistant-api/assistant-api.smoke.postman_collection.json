        {
          "name": "01 Create Assistant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/assistant/create-assistant",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "assistant",
                "create-assistant"
              ]
            },
            "description": "Create an assistant\n\nOpenAPI operationId: `createAssistant`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assistantProvider\": {\n    \"model\": {\n      \"modelProviderName\": \"{{modelProviderName}}\",\n      \"template\": {\n        \"prompt\": [\n          {\n            \"role\": \"system\",\n            \"content\": \"You are a helpful voice assistant.\"\n          }\n        ]\n      },\n      \"assistantModelOptions\": [\n        {\n          \"key\": \"temperature\",\n          \"value\": \"0.7\"\n        },\n        {\n          \"key\": \"max_tokens\",\n          \"value\": \"512\"\n        }\n      ]\n    }\n  },\n  \"description\": \"Assistant created from the Postman collection.\",\n  \"visibility\": \"private\",\n  \"language\": \"en\",\n  \"source\": \"postman\",\n  \"sourceIdentifier\": \"{{sourceIdentifier}}\",\n  \"tags\": [\n    \"postman\",\n    \"assistant-api\"\n  ],\n  \"name\": \"Postman Assistant\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "let jsonData = {};",
                  "if (pm.response && pm.response.text()) {",
                  "  jsonData = pm.response.json();",
                  "}",
                  "pm.test('success is true', function () {",
                  "  pm.expect(jsonData.success).to.eql(true);",
                  "});",
                  "pm.test('assistant is created', function () {",
                  "  const data = jsonData.data || {};",
                  "  pm.expect(data.name).to.eql('Postman Assistant');",
                  "  pm.expect(data.id).to.exist;",
                  "});",
                  "if (jsonData.data && jsonData.data.id) {",
                  "  pm.collectionVariables.set('assistantId', String(jsonData.data.id));",
                  "}"
                ]
              }
            }
          ]
        },
