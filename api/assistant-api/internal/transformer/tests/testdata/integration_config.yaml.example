# Integration test configuration for STT/TTS transformers.
#
# Default tests need no credentials.
# For live tests, copy this file to integration_config.yaml, fill in credentials,
# and enable only the providers you intend to call.
# integration_config.yaml is gitignored. Never commit real credentials.
#
# Live: go test -tags=integration -run '^TestTTSIntegration/cartesia/' ./api/assistant-api/internal/transformer/tests/integration
# Provider-specific TTS suite:
# go test -tags=integration -run '^TestCartesiaTTS' ./api/assistant-api/internal/transformer/tests/integration/cartesia

tts:
  deepgram:
    enabled: false
    credential:
      key: "YOUR_DEEPGRAM_API_KEY"
    options:
      speak.voice.id: "aura-asteria-en"

  elevenlabs:
    enabled: false
    credential:
      key: "YOUR_ELEVENLABS_API_KEY"
    options:
      speak.model: "eleven_turbo_v2"
      speak.voice.id: "21m00Tcm4TlvDq8ikWAM"

  cartesia:
    enabled: false
    credential:
      key: "YOUR_CARTESIA_API_KEY"
    options:
      speak.model: "sonic-english"
      speak.voice.id: "a0e99841-438c-4a64-b679-ae501e7d6091"

  google-speech-service:
    enabled: false
    credential:
      project_id: "YOUR_PROJECT_ID"
      # Paste the full service-account JSON as a YAML string, or leave empty for ADC.
      # project_id alone is not authentication. Do not combine API-key and JSON credentials.
      service_account_key: ""
    options:
      # Select a voice supported by streaming synthesis in your project.
      speak.voice.id: "YOUR_GOOGLE_STREAMING_VOICE_ID"

  azure-speech-service:
    enabled: false
    credential:
      subscription_key: "YOUR_AZURE_SPEECH_KEY"
      # Use the endpoint assigned to your Azure Speech resource.
      endpoint: "https://YOUR_AZURE_RESOURCE.cognitiveservices.azure.com/"
    options:
      speak.language: "en-US"
      speak.voice.id: "en-US-JennyNeural"

  sarvamai:
    enabled: false
    credential:
      key: "YOUR_SARVAM_API_KEY"
    options:
      speak.language: "en-IN"
      speak.model: "bulbul:v1"

  rime:
    enabled: false
    credential:
      key: "YOUR_RIME_API_KEY"
    options:
      speak.voice.id: "YOUR_RIME_VOICE_ID"

  resembleai:
    enabled: false
    credential:
      key: "YOUR_RESEMBLEAI_API_KEY"
    options:
      speak.voice.id: "YOUR_RESEMBLEAI_VOICE_UUID"

  neuphonic:
    enabled: false
    credential:
      key: "YOUR_NEUPHONIC_API_KEY"
    options:
      speak.voice.id: "YOUR_NEUPHONIC_VOICE_ID"

  minimax:
    enabled: false
    credential:
      key: "YOUR_MINIMAX_API_KEY"
      group_id: "YOUR_MINIMAX_GROUP_ID"
    options:
      speak.voice.id: "YOUR_MINIMAX_VOICE_ID"

  nvidia:
    enabled: false
    credential:
      key: "YOUR_NVIDIA_API_KEY"
      function_id: "YOUR_NVIDIA_TTS_FUNCTION_ID"
    options:
      speak.voice.id: "YOUR_NVIDIA_VOICE_ID"

  groq:
    enabled: false
    credential:
      key: "YOUR_GROQ_API_KEY"
    options:
      speak.model: "playai-tts"
      speak.voice.id: "Arista-PlayAI"

  speechmatics:
    enabled: false
    credential:
      key: "YOUR_SPEECHMATICS_API_KEY"
    options:
      speak.language: "en"

  aws:
    enabled: false
    credential:
      access_key_id: "YOUR_AWS_ACCESS_KEY_ID"
      secret_access_key: "YOUR_AWS_SECRET_ACCESS_KEY"
      region: "us-east-1"
    options:
      speak.voice.id: "Joanna"
      speak.model: "neural"

  smallest:
    enabled: false
    credential:
      key: "YOUR_SMALLEST_API_KEY"
    options:
      speak.voice.id: "magnus"
      speak.model: "lightning_v3.1"
      speak.language: "en"

stt:
  deepgram:
    enabled: false
    credential:
      key: "YOUR_DEEPGRAM_API_KEY"
    options:
      listen.model: "nova-2"
      listen.language: "en"
      listen.smart_format: true

  azure-speech-service:
    enabled: false
    credential:
      subscription_key: "YOUR_AZURE_SPEECH_KEY"
      # Use the endpoint assigned to your Azure Speech resource.
      endpoint: "https://YOUR_AZURE_RESOURCE.cognitiveservices.azure.com/"
    options:
      listen.language: "en-US"

  google-speech-service:
    enabled: false
    credential:
      project_id: "YOUR_PROJECT_ID"
      # Paste the full service-account JSON as a YAML string, or leave empty for ADC.
      # project_id alone is not authentication. Do not combine API-key and JSON credentials.
      service_account_key: ""
    options:
      listen.language: "en-US"
      listen.model: "latest_long"

  assemblyai:
    enabled: false
    credential:
      key: "YOUR_ASSEMBLYAI_API_KEY"
    options:
      listen.language: "en"

  revai:
    enabled: false
    credential:
      key: "YOUR_REVAI_API_KEY"
    options:
      listen.language: "en"

  sarvamai:
    enabled: false
    credential:
      key: "YOUR_SARVAM_API_KEY"
    options:
      listen.language: "en-IN"

  cartesia:
    enabled: false
    credential:
      key: "YOUR_CARTESIA_API_KEY"
    options:
      listen.language: "en"

  speechmatics:
    enabled: false
    credential:
      key: "YOUR_SPEECHMATICS_API_KEY"
    options:
      listen.language: "en"

  groq:
    enabled: false
    credential:
      key: "YOUR_GROQ_API_KEY"
    options:
      listen.model: "whisper-large-v3-turbo"
      listen.language: "en"

  nvidia:
    enabled: false
    credential:
      key: "YOUR_NVIDIA_API_KEY"
      function_id: "YOUR_NVIDIA_STT_FUNCTION_ID"
    options:
      listen.language: "en-US"

  aws:
    enabled: false
    credential:
      access_key_id: "YOUR_AWS_ACCESS_KEY_ID"
      secret_access_key: "YOUR_AWS_SECRET_ACCESS_KEY"
      region: "us-east-1"
    options:
      listen.language: "en-US"

  smallest:
    enabled: false
    credential:
      key: "YOUR_SMALLEST_API_KEY"
    options:
      listen.language: "en"
