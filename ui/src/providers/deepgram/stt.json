{
  "preservePrefix": "microphone.",
  "parameters": [
    {
      "key": "listen.model",
      "label": "Model",
      "type": "dropdown",
      "required": true,
      "default": "nova-3",
      "data": "speech-to-text-models.json",
      "valueField": "id",
      "errorMessage": "Please provide a valid deepgram model for speech to text."
    },
    {
      "key": "listen.smart_format",
      "label": "Smart Format",
      "type": "select",
      "required": false,
      "default": "true",
      "choices": [
        {
          "label": "True",
          "value": "true"
        },
        {
          "label": "False",
          "value": "false"
        }
      ]
    },
    {
      "key": "listen.filler_words",
      "label": "Filler Words",
      "type": "select",
      "required": false,
      "default": "true",
      "choices": [
        {
          "label": "True",
          "value": "true"
        },
        {
          "label": "False",
          "value": "false"
        }
      ]
    },
    {
      "key": "listen.endpointing",
      "label": "Endpointing (ms)",
      "type": "slider",
      "required": false,
      "default": "5",
      "min": 5,
      "max": 200,
      "step": 1
    },
    {
      "key": "listen.punctuate",
      "label": "Punctuate",
      "type": "select",
      "required": false,
      "default": "true",
      "choices": [
        {
          "label": "True",
          "value": "true"
        },
        {
          "label": "False",
          "value": "false"
        }
      ]
    },
    {
      "key": "listen.diarize",
      "label": "Diarize",
      "type": "select",
      "required": false,
      "default": "false",
      "choices": [
        {
          "label": "True",
          "value": "true"
        },
        {
          "label": "False",
          "value": "false"
        }
      ]
    }
  ]
}
