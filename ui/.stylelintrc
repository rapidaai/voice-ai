{
  "extends": ["stylelint-config-recommended"],
  "ignoreFiles": ["src/styles/generated/**"],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": ["custom-variant", "plugin", "theme"]
      }
    ],
    "media-query-no-invalid": [
      true,
      {
        "ignoreFunctions": ["theme"]
      }
    ]
  }
}
