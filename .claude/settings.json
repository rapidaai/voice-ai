{
  "permissions": {
    "deny": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(unlink *)",
      "Bash(shred *)",
      "Bash(truncate *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git branch -D *)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin master)",
      "Bash(git push origin master *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push --tags *)",
      "Bash(git push --mirror *)",
      "Bash(git push --delete *)",
      "Bash(git commit --no-verify)",
      "Bash(git commit --no-verify *)",
      "Bash(git push --no-verify)",
      "Bash(git push --no-verify *)",
      "Bash(git tag *)",
      "Bash(git config --global *)",
      "Bash(sudo *)",
      "Bash(doas *)",
      "Bash(chmod -R *)",
      "Bash(chown *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(gh repo delete *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/.npmrc)",
      "Read(./**/.netrc)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/*.har)",
      "Edit(./protos/**)",
      "Write(./protos/**)",
      "Edit(./api/integration-api/internal/caller/xai/artifacts/**)",
      "Write(./api/integration-api/internal/caller/xai/artifacts/**)",
      "Edit(./ui/src/styles/generated/**)",
      "Write(./ui/src/styles/generated/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/bash_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking command safety"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pr_gate.py\"",
            "timeout": 900,
            "statusMessage": "Checking pull request readiness"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/plan_reminder.py\"",
            "timeout": 10,
            "statusMessage": "Checking development plan"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/path_rules.py\"",
            "timeout": 10,
            "statusMessage": "Loading repository path rules"
          }
        ]
      }
    ]
  }
}
