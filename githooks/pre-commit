#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
ARGS=(hook-impl --config=.pre-commit-config.yaml --hook-type=pre-commit --hook-dir "$HOOK_DIR" -- "$@")

if [ -x "$ROOT/bin/pre-commit" ]; then
  exec "$ROOT/bin/pre-commit" "${ARGS[@]}"
elif command -v pre-commit >/dev/null 2>&1; then
  exec pre-commit "${ARGS[@]}"
elif command -v python3 >/dev/null 2>&1; then
  exec python3 -mpre_commit "${ARGS[@]}"
else
  echo '`pre-commit` not found. Run bin/git-commit-hook-setup.sh from the repository root.' 1>&2
  exit 1
fi
