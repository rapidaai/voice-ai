#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
message_file="${1:?commit message file is required}"
subject="$(awk '!/^[[:space:]]*#/ && /[^[:space:]]/ { print; exit }' "$message_file")"

python3 "$repo_root/bin/check-pr-body" --title-only --title "$subject"
