#!/usr/bin/env python3
"""Check added repository prose and identifiers against agent writing rules."""

from __future__ import annotations

import argparse
import codecs
import re
import subprocess
import sys
from collections import Counter
from dataclasses import dataclass, replace
from pathlib import Path


PROSE_SUFFIXES = {".md", ".rst", ".txt"}
COMMENT_LINE = re.compile(r"^\s*(?://|#|/\*|\*|<!--)")
BANNED_STEM = re.compile("normali" + "z", re.IGNORECASE)
TOOL_ATTRIBUTION = re.compile(r"co-authored-by|generated with|noreply@anthropic", re.IGNORECASE)
TODO = re.compile(r"\b(?:TODO|FIXME|HACK)\b")
TODO_OWNER = re.compile(r"(?:#[0-9]+|https?://|owner\s*:|remove(?:d)?\s+when)", re.IGNORECASE)
HUNK = re.compile(r"^@@ -(\d+)(?:,\d+)? \+(\d+)(?:,\d+)? @@")
GO_TOKEN = re.compile(
    r'//[^\n]*|/\*[\s\S]*?(?:\*/|\Z)|`[^`]*(?:`|\Z)|'
    r'"(?:\\[\s\S]|[^"\\])*(?:"|\Z)|'
    r"'(?:\\[\s\S]|[^'\\])*(?:'|\Z)|(?P<identifier>[^\W\d]\w*)"
)


@dataclass(frozen=True)
class AddedLine:
    path: str
    number: int
    text: str
    introduced_text: str | None = None


def run_git(root: Path, arguments: list[str]) -> str:
    result = subprocess.run(
        ["git", *arguments],
        cwd=root,
        capture_output=True,
        check=False,
        text=True,
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or f"git {' '.join(arguments)} failed")
    return result.stdout


def go_identifiers(lines: list[str]) -> list[tuple[int, int, str]]:
    source = "\n".join(lines)
    identifiers = []
    for match in GO_TOKEN.finditer(source):
        name = match.group("identifier")
        if name and BANNED_STEM.search(name):
            row = source.count("\n", 0, match.start())
            column = match.start() - source.rfind("\n", 0, match.start()) - 1
            identifiers.append((row, column, name))
    return identifiers


def header_path(value: str) -> str:
    value = value.removesuffix("\t")
    if value.startswith('"') and value.endswith('"'):
        return codecs.escape_decode(value[1:-1].encode("utf-8"))[0].decode("utf-8", "surrogateescape")
    return value


def parse_added_lines(diff: str) -> list[AddedLine]:
    lines: list[AddedLine] = []
    for section in re.split(r"(?=^diff --git )", diff, flags=re.MULTILINE):
        path = old_path = ""
        number = hunks = 0
        starts_at_top = False
        before: list[str] = []
        after: list[str] = []
        removed: set[int] = set()
        added: dict[int, AddedLine] = {}
        for line in section.splitlines():
            if not hunks and line.startswith("--- "):
                old_path = header_path(line[4:]).removeprefix("a/")
            elif not hunks and line.startswith("+++ "):
                path = header_path(line[4:]).removeprefix("b/")
            elif match := HUNK.match(line):
                hunks += 1
                number = int(match.group(2))
                starts_at_top = int(match.group(1)) <= 1 and number <= 1
            elif hunks and line.startswith("+"):
                added[len(after)] = AddedLine(path, number, line[1:])
                after.append(line[1:])
                number += 1
            elif hunks and line.startswith("-"):
                removed.add(len(before))
                before.append(line[1:])
            elif hunks and line.startswith(" "):
                before.append(line[1:])
                after.append(line[1:])
                number += 1
        # Full Go context distinguishes identifiers from comments and string literals.
        if path.endswith(".go") and path == old_path and hunks == 1 and starts_at_top:
            credits = Counter(name for row, _, name in go_identifiers(before) if row in removed)
            for row, column, name in go_identifiers(after):
                if row in added and credits[name]:
                    entry = added[row]
                    text = entry.introduced_text if entry.introduced_text is not None else entry.text
                    added[row] = replace(
                        entry, introduced_text=text[:column] + " " * len(name) + text[column + len(name):]
                    )
                    credits[name] -= 1
        lines.extend(added.values())
    return lines


def untracked_lines(root: Path) -> list[AddedLine]:
    output = run_git(root, ["ls-files", "--others", "--exclude-standard", "-z"])
    lines: list[AddedLine] = []
    for name in output.rstrip("\0").split("\0") if output else []:
        path = root / name
        try:
            content = path.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError):
            continue
        lines.extend(AddedLine(name, index, value) for index, value in enumerate(content.splitlines(), 1))
    return lines


def changed_lines(root: Path, mode: str, revision_range: str | None) -> list[AddedLine]:
    arguments = ["diff", "--no-ext-diff", "--no-color", "--unified=2147483647"]
    if mode == "staged":
        arguments.append("--cached")
    elif mode == "range":
        assert revision_range is not None
        arguments.append(revision_range)
    else:
        arguments.append("HEAD")
    arguments.append("--")
    lines = parse_added_lines(run_git(root, arguments))
    if mode == "working-tree":
        lines.extend(untracked_lines(root))
    return lines


def validate(lines: list[AddedLine]) -> list[str]:
    failures: list[str] = []
    for line in lines:
        suffix = Path(line.path).suffix.lower()
        is_prose = suffix in PROSE_SUFFIXES
        is_comment = COMMENT_LINE.match(line.text) is not None
        introduced = line.introduced_text if line.introduced_text is not None else line.text
        if BANNED_STEM.search(introduced):
            failures.append(f"{line.path}:{line.number}: prohibited vague transformation stem")
        if (is_prose or is_comment) and "—" in line.text:
            failures.append(f"{line.path}:{line.number}: em dash is not allowed")
        if (is_prose or is_comment) and TOOL_ATTRIBUTION.search(line.text):
            failures.append(f"{line.path}:{line.number}: tooling attribution is not allowed")
        if is_comment and TODO.search(line.text) and TODO_OWNER.search(line.text) is None:
            failures.append(f"{line.path}:{line.number}: TODO-like comment needs an owner or removal condition")
    return failures


def main() -> int:
    parser = argparse.ArgumentParser()
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--staged", action="store_true")
    mode.add_argument("--range", dest="revision_range")
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parent.parent)
    args = parser.parse_args()
    selected_mode = "staged" if args.staged else "range" if args.revision_range else "working-tree"
    try:
        failures = validate(changed_lines(args.root.resolve(), selected_mode, args.revision_range))
    except RuntimeError as error:
        print(f"agent style: {error}", file=sys.stderr)
        return 2
    if failures:
        for failure in failures:
            print(f"agent style: {failure}", file=sys.stderr)
        return 1
    print("agent style validation passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
