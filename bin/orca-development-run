#!/usr/bin/env bash
set -euo pipefail

objective="${1:-}"
planner_agent="${2:-}"
rfc_path="${3:-}"
rfc_artifact_dir="${rfc_path%.md}/jsons"

if [[ -z "$objective" || -z "$planner_agent" || -z "$rfc_path" ]]; then
  echo "Usage: $0 <objective> <planner-agent> <reserved-rfc-path>" >&2
  exit 2
fi

if [[ "$rfc_path" == /* || ! "$rfc_path" =~ ^rfcs/[0-9]{4}-[a-z0-9]+([a-z0-9-]*[a-z0-9])?\.md$ ]]; then
  echo "RFC path must be a relative unused path matching rfcs/NNNN-short-name.md." >&2
  exit 2
fi

if [[ -e "$rfc_path" || -L "$rfc_path" ]]; then
  echo "Reserved RFC path already exists: $rfc_path" >&2
  exit 2
fi

git_common_dir="$(git rev-parse --git-common-dir 2>/dev/null || true)"
reservation_root="${git_common_dir:+$git_common_dir/orca-rfc-reservations}"
if [[ -z "$reservation_root" ]]; then
  echo "RFC reservation requires a Git worktree." >&2
  exit 1
fi
mkdir -p "$reservation_root"
reservation_name="${rfc_path#rfcs/}"
reservation_lock="$reservation_root/$reservation_name.lock"
if ! mkdir "$reservation_lock" 2>/dev/null; then
  echo "RFC path is already reserved by another Run: $rfc_path" >&2
  echo "If that Run was abandoned, release it with: make orca-rfc-release RFC='$rfc_path'" >&2
  exit 2
fi
reservation_active=1
cleanup_reservation() {
  if [[ "$reservation_active" == 1 ]]; then
    rmdir "$reservation_lock" 2>/dev/null || true
  fi
}
trap cleanup_reservation EXIT

if [[ -n "${ORCA_CLI_COMMAND:-}" ]]; then
  read -r -a orca_cmd <<<"$ORCA_CLI_COMMAND"
elif [[ -n "${ORCA_DEV_REPO_ROOT:-}" ]]; then
  orca_cmd=(orca-dev)
elif [[ "$(uname -s)" == "Linux" ]]; then
  orca_cmd=(orca-ide)
else
  orca_cmd=(orca)
fi

if ! command -v "${orca_cmd[0]}" >/dev/null 2>&1; then
  echo "Orca CLI is not installed or not on PATH." >&2
  exit 1
fi

echo "Starting Governed workflow. Use the normal agent flow for Fast or Standard work." >&2

run_orca() {
  "${orca_cmd[@]}" "$@"
}

status_response="$(run_orca status --json)"
printf '%s' "$status_response" | python3 -c '
import json
import sys

payload = json.load(sys.stdin)
result = payload.get("result") or {}
app = result.get("app") or {}
runtime = result.get("runtime") or {}
if not app.get("running") or not runtime.get("reachable"):
    raise SystemExit("Orca app/runtime is not running or reachable. Start Orca and enable orchestration.")
'

extract_id() {
  local kind="$1"
  python3 -c '
import json
import sys

kind = sys.argv[1]
payload = json.load(sys.stdin)
preferred = {
    "run": ("runId", "run_id"),
    "task": ("taskId", "task_id"),
}

def find(value):
    if isinstance(value, dict):
        for key in preferred[kind]:
            candidate = value.get(key)
            if isinstance(candidate, str) and candidate:
                return candidate
        nested = value.get(kind)
        if isinstance(nested, dict):
            candidate = nested.get("id")
            if isinstance(candidate, str) and candidate:
                return candidate
        for child in value.values():
            candidate = find(child)
            if candidate:
                return candidate
    elif isinstance(value, list):
        for child in value:
            candidate = find(child)
            if candidate:
                return candidate
    return None

identifier = find(payload)
if not identifier:
    raise SystemExit(f"Unable to find {kind} id in Orca response")
print(identifier)
' "$kind"
}

run_response="$(run_orca orchestration run-create --objective "$objective" --json)"
run_id="$(printf '%s' "$run_response" | extract_id run)"

create_task() {
  local title="$1"
  local spec="$2"
  local deps="${3:-}"
  local response

  if [[ -n "$deps" ]]; then
    response="$(run_orca orchestration task-create --run "$run_id" --task-title "$title" --spec "$spec" --deps "$deps" --json)"
  else
    response="$(run_orca orchestration task-create --run "$run_id" --task-title "$title" --spec "$spec" --json)"
  fi
  printf '%s' "$response" | extract_id task
}

planner_task="$(create_task \
  "Understand and plan" \
  "Investigate: $objective. Use the task-planner role and task-plan template. Do not edit repository files. Produce verified context, acceptance criteria, non-goals, explicit path ownership, principle decisions, risks, exact verification commands, and open questions. The coordinator will store the plan at $rfc_artifact_dir/plan.json. Hand the completed plan to the RFC author; do not approve it.")"

rfc_task="$(create_task \
  "Draft reserved RFC" \
  "Draft and revise the RFC for: $objective. Use rfcs/TEMPLATE.md and the rfc-author role. The only path you may create or edit is $rfc_path, which the coordinator reserved for this run. Translate the completed plan into exact RFC bytes with contracts, alternatives, migration, testing, observability, rollback, and open decisions. Before final challenge approval, set the sole metadata status line to '- Status: Accepted'. Do not edit the RFC index or write JSON outside $rfc_artifact_dir/." \
  "[\"$planner_task\"]")"

challenger_task="$(create_task \
  "Challenge exact plan and RFC" \
  "Independently challenge the completed plan and the exact RFC at $rfc_path for: $objective. Use the plan-challenger role and remain read-only. Verify the RFC matches the plan, identify a simpler solution, ownership conflicts, missing contracts, unsafe failure paths, weak tests, and rollout risks. Return approve, revise, or block with evidence. The coordinator stores an approval receipt at $rfc_artifact_dir/challenge.json. Approval applies only to the reviewed RFC bytes; any later RFC change requires another challenge and confirmation. Allow at most two revision rounds, then block and escalate unresolved decisions." \
  "[\"$rfc_task\"]")"

planner_response="$(run_orca orchestration worker-start \
  --run "$run_id" \
  --task "$planner_task" \
  --worktree current \
  --agent "$planner_agent" \
  --json)"

cat <<EOF
Orca RFC planning run created.

Run:             $run_id
Planner task:    $planner_task
RFC author task: $rfc_task
Challenge task:  $challenger_task
Reserved RFC:    $rfc_path

Only the planner worker has started. Implementation, verification, and review
tasks must not be created until the challenged RFC is confirmed and committed as
the governance baseline.

After the RFC author and challenger finish, create the exact-digest confirmation gate:
  make orca-confirm-rfc-create RUN_ID="$run_id" CHALLENGE_TASK_ID="$challenger_task" RFC="$rfc_path" CHALLENGE_RECEIPT="$rfc_artifact_dir/challenge.json"

After the gate is resolved, collect the receipt and record the governance baseline:
  make orca-confirm-rfc-collect RUN_ID="$run_id" TASK_ID="<confirmation-task-id>" CHALLENGE_TASK_ID="$challenger_task" CHALLENGE_RECEIPT="$rfc_artifact_dir/challenge.json" RFC="$rfc_path" GATE_ID="<gate-id>"
  git add "$rfc_path" "$rfc_artifact_dir/plan.json" "$rfc_artifact_dir/challenge.json" "$rfc_artifact_dir/confirmation.json"
  git commit -m "docs: accept RFC for $objective"
  DEVELOPMENT_GATE_KEY="..." make sign-approved-plan RUN_ID="$run_id" PLAN="$rfc_artifact_dir/plan.json" BASE_REF="<governance-commit>"

Only after the receipt and governance baseline are preserved may the coordinator create
implementation, verification, and review tasks.

Planner receipt:
$planner_response
EOF
reservation_active=0
