#!/usr/bin/env python3
"""Render nested agent instructions from the repository path-rule registry."""

from __future__ import annotations

import argparse
import fnmatch
import json
import subprocess
import sys
from pathlib import Path


HEADER = "# Agent path rules:"
SOURCE = "Generated from `agent-rules.json`. Do not edit this file directly."


def tracked_paths(root: Path) -> list[str]:
    result = subprocess.run(
        ["git", "ls-files", "--cached", "--others", "--exclude-standard"],
        cwd=root,
        capture_output=True,
        check=False,
        text=True,
    )
    if result.returncode != 0:
        raise ValueError(result.stderr.strip() or "cannot enumerate repository files")
    return [
        path
        for path in result.stdout.splitlines()
        if Path(path).name not in {"AGENTS.md", "CLAUDE.md"}
    ]


def validate_relative(value: str, label: str, rule_id: str) -> None:
    candidate = Path(value)
    if not value or candidate.is_absolute() or ".." in candidate.parts:
        raise ValueError(f"path rule {rule_id} has invalid {label}: {value!r}")


def load_rules(root: Path) -> list[dict[str, object]]:
    registry = root / "agent-rules.json"
    document = json.loads(registry.read_text(encoding="utf-8"))
    if document.get("version") != 1 or not isinstance(document.get("rules"), list):
        raise ValueError("agent-rules.json must contain version 1 and a rules array")

    seen_ids: set[str] = set()
    claimed_dirs: set[str] = set()
    paths = tracked_paths(root)
    rules: list[dict[str, object]] = []
    for rule in document["rules"]:
        if not isinstance(rule, dict):
            raise ValueError("each path rule must be an object")
        rule_id = rule.get("id")
        title = rule.get("title")
        directories = rule.get("directories")
        patterns = rule.get("paths")
        instructions = rule.get("instructions")
        if not isinstance(rule_id, str) or not rule_id or rule_id in seen_ids:
            raise ValueError(f"invalid or duplicate path rule id: {rule_id!r}")
        if not isinstance(title, str) or not title:
            raise ValueError(f"path rule {rule_id} needs a title")
        if not isinstance(directories, list) or not all(isinstance(item, str) for item in directories):
            raise ValueError(f"path rule {rule_id} has invalid directories")
        if not isinstance(patterns, list) or not patterns or not all(isinstance(item, str) for item in patterns):
            raise ValueError(f"path rule {rule_id} has invalid paths")
        if not isinstance(instructions, list) or not instructions or not all(
            isinstance(item, str) and item for item in instructions
        ):
            raise ValueError(f"path rule {rule_id} has invalid instructions")
        for directory in directories:
            validate_relative(directory, "directory", rule_id)
            target_directory = root / directory
            try:
                target_directory.resolve().relative_to(root)
            except ValueError as error:
                raise ValueError(f"path rule {rule_id} directory leaves the repository: {directory}") from error
            if directory in claimed_dirs:
                raise ValueError(f"more than one path rule claims {directory}")
            if target_directory.is_symlink():
                raise ValueError(f"path rule {rule_id} names a symlink directory: {directory}")
            if not target_directory.is_dir():
                raise ValueError(f"path rule {rule_id} names missing directory {directory}")
            claimed_dirs.add(directory)
        for pattern in patterns:
            validate_relative(pattern, "path pattern", rule_id)
            if not any(fnmatch.fnmatchcase(path, pattern) for path in paths):
                raise ValueError(f"path rule {rule_id} pattern matches no repository files: {pattern}")
        seen_ids.add(rule_id)
        rules.append(rule)
    return rules


def render(rule: dict[str, object]) -> str:
    title = str(rule["title"])
    instructions = rule["instructions"]
    assert isinstance(instructions, list)
    lines = [f"{HEADER} {title}", "", SOURCE, "", "These rules extend the repository root instructions:", ""]
    lines.extend(f"- {instruction}" for instruction in instructions)
    return "\n".join(lines) + "\n"


def run(root: Path, check: bool) -> int:
    failures: list[str] = []
    expected_targets: set[Path] = set()
    for rule in load_rules(root):
        expected = render(rule)
        directories = rule["directories"]
        assert isinstance(directories, list)
        for directory in directories:
            for name in ("AGENTS.md", "CLAUDE.md"):
                target = root / str(directory) / name
                expected_targets.add(target)
                if target.is_symlink():
                    raise ValueError(f"refusing agent rule symlink {target.relative_to(root)}")
                if check:
                    if not target.is_file() or target.read_text(encoding="utf-8") != expected:
                        failures.append(str(target.relative_to(root)))
                    continue
                if target.exists() and not target.read_text(encoding="utf-8").startswith(HEADER):
                    raise ValueError(f"refusing to replace unmanaged file {target.relative_to(root)}")
                target.write_text(expected, encoding="utf-8")

    for name in ("AGENTS.md", "CLAUDE.md"):
        for target in root.rglob(name):
            if target in expected_targets or target.is_symlink() or not target.is_file():
                continue
            try:
                is_generated = target.read_text(encoding="utf-8").startswith(HEADER)
            except (OSError, UnicodeDecodeError):
                continue
            if is_generated:
                failures.append(str(target.relative_to(root)))

    if failures:
        for path in failures:
            print(f"agent rules drift: {path}", file=sys.stderr)
        print("run `python3 bin/render-agent-rules`", file=sys.stderr)
        return 1
    action = "match" if check else "rendered from"
    print(f"agent path rules {action} agent-rules.json")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parent.parent)
    args = parser.parse_args()
    try:
        return run(args.root.resolve(), args.check)
    except (OSError, ValueError, json.JSONDecodeError) as error:
        print(f"agent rules: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
